# Environment for the docker compose stack. Copy to .env.production on each
# machine that runs it and fill in real values. Never commit .env.production.

# Decrypts config/credentials.yml.enc. Value is the content of config/master.key.
RAILS_MASTER_KEY=

# Base URL used to build the short links returned by the API.
HOST=https://short.mandyseeyoo.com

# Hostname Caddy serves. Set to ":80" to serve plain HTTP by IP address, which
# also turns off Caddy's automatic HTTPS (useful before DNS is pointed at the server).
APP_DOMAIN=short.mandyseeyoo.com

# Postgres credentials, used both by the db container and by config/database.yml.
POSTGRES_USER=url_shortening_service
POSTGRES_PASSWORD=
POSTGRES_DB=url_shortening_service_production
