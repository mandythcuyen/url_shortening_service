# Copy to .env and fill in real values. Never commit .env.
#
# Decrypts config/credentials.yml.enc. Value comes from config/master.key.
RAILS_MASTER_KEY=

# Base URL used to build short links.
HOST=http://localhost:3000

# Cache store and Action Cable.
REDIS_URL=redis://localhost:6379/0

# --- Only needed by docker compose (production-like stack) ---
# Public domain served by Caddy. Use ":80" to serve over plain HTTP by IP.
APP_DOMAIN=localhost
# Email registered with Let's Encrypt for certificate notices.
CADDY_EMAIL=
# Postgres credentials for the bundled db service.
POSTGRES_USER=url_shortening_service
POSTGRES_PASSWORD=
POSTGRES_DB=url_shortening_service_production
